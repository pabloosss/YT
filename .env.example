# =========================
# SILNIK TEKSTOWY AI
# =========================
# demo | ollama | openai
AI_PROVIDER=ollama
AI_STUDIO_DEMO=false
AI_STUDIO_SETTINGS_VERSION=3

# Lokalna Ollama
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:30b
OLLAMA_TIMEOUT=900

# Pamięć / wydajność Ollamy
# Główny limit zarządzany suwakiem w aplikacji.
OLLAMA_RAM_LIMIT_PERCENT=75

# num_ctx zwiększa pamięć roboczą wraz z długością kontekstu.
OLLAMA_NUM_CTX=4096
OLLAMA_NUM_PREDICT=2048

# 0 = Ollama sama dobiera liczbę wątków CPU
OLLAMA_NUM_THREAD=0

# true = model może wykonywać dodatkowe rozumowanie wewnętrzne.
# Aplikacja pokazuje postęp i wynik, ale nie wyświetla ukrytego toku rozumowania.
OLLAMA_THINK=true

# Jak długo model ma zostać załadowany po odpowiedzi.
OLLAMA_KEEP_ALIVE=15m

# true = zwolnij model z pamięci po każdym zapytaniu.
# Oszczędza RAM, ale każdy kolejny agent ładuje model od nowa.
OLLAMA_UNLOAD_AFTER_REQUEST=false

# OpenAI - opcjonalne dla tekstu albo mediów
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6

PROJECTS_DIR=projects

# Media są domyślnie wyłączone.
GENERATE_MEDIA=false

OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_SIZE=1536x1024
OPENAI_IMAGE_QUALITY=low

OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=coral
OPENAI_TTS_INSTRUCTIONS=Mów naturalnie po polsku, energicznie, ale bez przesadnej teatralności.

FFMPEG_PATH=ffmpeg

