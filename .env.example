OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6
AI_STUDIO_DEMO=true
PROJECTS_DIR=projects

# Media są domyślnie wyłączone, żeby nie generować kosztów przypadkiem.
GENERATE_MEDIA=false

OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_SIZE=1536x1024
OPENAI_IMAGE_QUALITY=low

OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=coral
OPENAI_TTS_INSTRUCTIONS=Mów naturalnie po polsku, energicznie, ale bez przesadnej teatralności.

FFMPEG_PATH=ffmpeg
