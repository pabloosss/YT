# Lokalny silnik tekstowy
AI_PROVIDER=ollama
AI_STUDIO_DEMO=false
AI_STUDIO_SETTINGS_VERSION=5
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_TIMEOUT=900
OLLAMA_RAM_LIMIT_PERCENT=50
OLLAMA_NUM_CTX=4096
OLLAMA_NUM_PREDICT=2048
OLLAMA_NUM_THREAD=0
OLLAMA_THINK=true
OLLAMA_KEEP_ALIVE=15m
OLLAMA_UNLOAD_AFTER_REQUEST=false

PROJECTS_DIR=projects
FFMPEG_PATH=ffmpeg

# Pionowy film TikTok / YouTube Shorts: 9:16, 30 sekund, 4 klipy Veo.
GENERATE_MEDIA=false
GOOGLE_API_KEY=
ELEVENLABS_API_KEY=

VEO_MODEL=veo-3.1-fast-generate-preview
VEO_ASPECT_RATIO=9:16
VEO_RESOLUTION=720p
VEO_MAX_CLIPS=4

ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2
BURN_SUBTITLES=true

# Opcjonalny lokalny plik muzyczny, do którego masz prawa.
MUSIC_PATH=

# Zachowane dla zgodności z wcześniejszymi projektami.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_SIZE=1536x1024
OPENAI_IMAGE_QUALITY=low
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=coral
