# =========================
# SILNIK TEKSTOWY AI
# =========================
# demo | ollama | openai
AI_PROVIDER=demo
AI_STUDIO_DEMO=true

# Lokalna Ollama
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:30b
OLLAMA_TIMEOUT=900
OLLAMA_KEEP_ALIVE=15m

# OpenAI - opcjonalne dla tekstu albo mediów
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6

PROJECTS_DIR=projects

# Media są domyślnie wyłączone, żeby nie generować kosztów przypadkiem.
# Przy lokalnej Ollamie zostaw false, dopóki nie skonfigurujemy generatora
# grafiki/lektorów.
GENERATE_MEDIA=false

OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_SIZE=1536x1024
OPENAI_IMAGE_QUALITY=low

OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=coral
OPENAI_TTS_INSTRUCTIONS=Mów naturalnie po polsku, energicznie, ale bez przesadnej teatralności.

FFMPEG_PATH=ffmpeg
